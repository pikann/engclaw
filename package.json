{
  "name": "engclaw",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "esbuild"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "package": "bun run --cwd apps/desktop package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:e2e": "bun run --cwd apps/desktop test:e2e",
    "license:check": "license-checker-rseidelsohn --start apps/desktop --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;Unlicense;GPL-3.0-or-later;MPL-2.0;OFL-1.1;(Apache-2.0 AND BSD-3-Clause)\"",
    "license:generate": "license-checker-rseidelsohn --start apps/desktop --production --excludePrivatePackages --markdown --out THIRD_PARTY_LICENSES.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
