{
  "name": "@engclaw/desktop",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "Engclaw desktop app",
  "homepage": "https://github.com/pikann/engclaw",
  "author": "Engclaw",
  "main": "./out/main/index.js",
  "scripts": {
    "espeak": "bash ../../scripts/espeak/build.sh",
    "predev": "bash ../../scripts/espeak/build.sh || echo 'warning: could not stage espeak-ng; scoring will not work (see CONTRIBUTING.md)'",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepackage": "bash ../../scripts/espeak/build.sh",
    "package": "electron-vite build && electron-builder --dir",
    "predist": "bash ../../scripts/espeak/build.sh",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "media": "electron-vite build && playwright test -c playwright.media.config.ts",
    "test:e2e:headed": "E2E_HEADED=1 playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@fontsource-variable/inter": "^5.3.0",
    "ai": "^7.0.165",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "electron-updater": "^6.8.11",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "onnxruntime-node": "^1.31.1",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.5",
    "quickjs-emscripten": "^0.32.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-resizable-panels": "^4.19.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "youtubei.js": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@engclaw/dictionary": "workspace:*",
    "@engclaw/game": "workspace:*",
    "@engclaw/i18n": "workspace:*",
    "@engclaw/ipc-contract": "workspace:*",
    "@engclaw/models": "workspace:*",
    "@engclaw/pronounce": "workspace:*",
    "@engclaw/prosody": "workspace:*",
    "@engclaw/youtube": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.6"
  }
}
